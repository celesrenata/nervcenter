# NerveCenter Web — nginx config TEMPLATE (rendered at container start).
#
# Rendered by web/entrypoint.sh via:
#   envsubst '${API_UPSTREAM} ${API_PORT}'
# Only ${API_UPSTREAM} and ${API_PORT} are substituted (scoped list); all
# other nginx runtime variables ($host, $uri, $remote_addr, $scheme,
# $proxy_add_x_forwarded_for) are left intact.
#
#   /            -> static SPA, deep links fall back to /index.html
#   /api/        -> proxied to the api service (FastAPI, :8000)
#   /mcp/        -> proxied to the api service (MCP streamable-HTTP, :8000)

worker_processes auto;
error_log /dev/stderr warn;
pid /var/run/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  sendfile on;
  keepalive_timeout 65;
  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json image/svg+xml;

  server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
      proxy_pass http://${API_UPSTREAM}:${API_PORT};
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      # SSE/streaming responses: no buffering.
      proxy_buffering off;
      proxy_cache off;
      proxy_read_timeout 300s;
    }

    location /mcp/ {
      proxy_pass http://${API_UPSTREAM}:${API_PORT};
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      # MCP is streamable-HTTP (long-lived responses): no buffering.
      proxy_buffering off;
      proxy_cache off;
      proxy_request_buffering off;
      proxy_read_timeout 300s;
      chunked_transfer_encoding on;
    }

    location / {
      # SPA: deep links fall back to index.html and the router resolves.
      try_files $uri $uri/ /index.html;
    }
  }
}
