# NerveCenter self-hosting — fastlane / xcodebuild environment.
#
# Copy this file to .env (which is gitignored) and fill in your values.
# `fastlane` and `export_app.sh` read NERVE_TEAM_ID for ad-hoc export.

# Your Apple Developer "personal team" ID (visible in the Apple Developer
# account page, or in the provisioning profile). Used as `teamID` in the
# export_options.plist. Personal team ID format: ABCDEFGH12.
NERVE_TEAM_ID=

# Where generated archives + export artifacts land (defaults to ../build).
NERVE_BUILD_ROOT=

# (Optional) Override the API base baked into Info.plist at build time.
# The Info.plist ships a sane default; set this only if you need to
# re-bake a different base for the self-hosted build.
NERVE_API_BASE=https://nerv.celestium.life/api
