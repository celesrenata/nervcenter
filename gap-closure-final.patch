+ */
+:root {
+  /* Surfaces */
+  --nc-canvas: #f3f4f6;        /* page background */
+  --nc-surface: #ffffff;       /* cards, sidebar, panels */
+  --nc-surface-elevated: #ffffff; /* drawers / floating chrome */
+  --nc-border: #d7dbe2;
+
