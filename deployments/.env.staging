# Environment configuration for NerveCenter staging environment

# Application settings
APP_ENV=staging
LOG_LEVEL=info

# Database settings
DATABASE_HOST=staging-db
DATABASE_PORT=5432
DATABASE_NAME=nervcenter
DATABASE_USER=staging_user
DATABASE_PASSWORD=staging_password

# Redis settings
REDIS_HOST=staging-redis
REDIS_PORT=6379

# Service settings
API_PORT=8080

# Secret keys
SECRET_KEY=staging-secret-key