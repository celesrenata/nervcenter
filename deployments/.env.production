# Environment configuration for NerveCenter production environment

# Application settings
APP_ENV=production
LOG_LEVEL=error

# Database settings
DATABASE_HOST=production-db
DATABASE_PORT=5432
DATABASE_NAME=nervcenter
DATABASE_USER=production_user
DATABASE_PASSWORD=production_password

# Redis settings
REDIS_HOST=production-redis
REDIS_PORT=6379

# Service settings
API_PORT=8080

# Secret keys
SECRET_KEY=production-secret-key