# nervecenter-env Secret — TEMPLATE ONLY.
#
#   cp secrets.yaml.example secrets.yaml      # secrets.yaml is gitignored
#   <edit secrets.yaml: base64-encode your real values>
#   kubectl -n nervecenter apply -f secrets.yaml
#
# The base values below are coherent PLACEHOLDERS for this cluster's topology
# (postgres/nats/omniroute inside the nervecenter namespace, in-cluster DNS).
# Re-encode after any change:  printf '%s' 'value' | base64
#
# Naming contract: the T104 deploy contract is NERVE_*; the backend currently
# reads NERVECENTER_* (backend/persistence/connection.py, backend/events/
# nats_client.py). Both are set here so the app works before T101 normalizes
# the env-var names — envFrom injects every key below into the api & migrate
# containers.
apiVersion: v1
kind: Secret
metadata:
  name: nervecenter-env
  namespace: nervecenter
  labels:
    app: nervcenter
    app.kubernetes.io/name: env
type: Opaque
data:
  # --- T104 deploy contract (NERVE_*) ---
  # base64 of: postgresql+asyncpg://nervcenter:nervcenter@postgres.nervecenter.svc:5432/nervcenter
  NERVE_DB_URL: "cG9zdGdyZXNxbCthc3luY3BnOi8vbmVydmNlbnRlcjpuZXJ2Y2VudGVyQHBvc3RncmVzLm5lcnZlY2VudGVyLnN2Yzo1NDMyL25lcnZjZW50ZXI="
  # base64 of: nats://nats.nervecenter.svc:4222
  NERVE_NATS_URL: "bmF0czovL25hdHMubmVydmVjZW50ZXIuc3ZjOjQyMjI="
  # base64 of: https://omniroute.nervecenter.svc:8080
  NERVE_OMNIROUTE_URL: "aHR0cHM6Ly9vbW5pcm91dGUubmVydmVjZW50ZXIuc3ZjOjgwODA="
  # base64 of: 1
  NERVE_MOCK_INFER: "MQ=="
  # --- backend runtime names (NERVECENTER_*) ---
  NERVECENTER_DATABASE_URL: "cG9zdGdyZXNxbCthc3luY3BnOi8vbmVydmNlbnRlcjpuZXJ2Y2VudGVyQHBvc3RncmVzLm5lcnZlY2VudGVyLnN2Yzo1NDMyL25lcnZjZW50ZXI="
  NERVECENTER_NATS_URL: "bmF0czovL25hdHMubmVydmVjZW50ZXIuc3ZjOjQyMjI="
  NERVECENTER_MOCK_INFER: "MQ=="
